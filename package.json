{
  "publisher": "eriolfos",
  "name": "illumina",
  "displayName": "Illumina",
  "description": "A tool for visual exploration of source code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [
    "workspaceContains:**/*"
  ],
  "main": "./dist/main.js",
  "contributes": {
    "configuration": {
      "title": "Illumina",
      "properties": {
        "illumina.sourceDirectory": {
          "scope": "resource",
          "type": "string",
          "pattern": "^[^/\\\\][^:*?\"<>|]*$",
          "default": "",
          "description": "Relative path from workspace root to the source code directory. Leave empty to use workspace root."
        },
        "illumina.sourceLanguage": {
          "scope": "resource",
          "type": "string",
          "enum": [
            ".java",
            ".cpp"
          ],
          "default": ".java",
          "description": "Supported programming language for analysis in current workspace."
        },
        "illumina.delayMode": {
          "scope": "resource",
          "type": "string",
          "enum": [
            "debounce",
            "throttle"
          ],
          "enumDescriptions": [
            "Wait until changes stop before updating",
            "Update at fixed intervals while changes occur"
          ],
          "default": "debounce",
          "description": "How to handle rapid file changes during analysis."
        },
        "illumina.delayTime": {
          "scope": "resource",
          "type": "number",
          "minimum": 500,
          "maximum": 5000,
          "default": 1000,
          "description": "Delay time in milliseconds for handling file changes."
        },
        "illumina.maxCacheSize": {
          "scope": "resource",
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 5,
          "description": "Maximum number of parsed files to keep in memory."
        }
      }
    },
    "commands": []
  },
  "scripts": {
    "build-ext": "webpack",
    "build-webview": "vite build",
    "build": "npm run build-ext && npm run build-webview",
    "watch-ext": "webpack --watch",
    "watch-webview": "vite build --watch",
    "watch": "concurrently \"npm run watch-ext\" \"npm run watch-webview\"",
    "lint": "eslint src",
    "build-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run lint && npm run build-tests && npm run build",
    "test": "vscode-test",
    "package": "webpack --mode production --devtool hidden-source-map && vite build",
    "vscode:prepublish": "npm run package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "lru-cache": "^11.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tree-sitter": "^0.21.1",
    "tree-sitter-java": "^0.23.4"
  }
}
